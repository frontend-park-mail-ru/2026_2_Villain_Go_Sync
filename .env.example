# Скопируйте этот файл в .env и поменяйте значения под своё окружение.

# Порт dev-сервера.
PORT=8000

# Адрес бэкенда, подставляется в код при сборке. Для адреса фронтенда на бэкенде должен быть разрешён CORS.
API_URL=http://localhost:8080/api

# Локальный сервис OnlineConf, на который Webpack проксирует /api/onlineconf.
ONLINECONF_DEV_TARGET=http://127.0.0.1:8081
