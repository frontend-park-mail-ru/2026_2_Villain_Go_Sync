<nav class="pagination" aria-label="Страницы">
  {{#each items}}
    {{#if isGap}}
      <span class="pagination__item pagination__item_gap">…</span>
    {{else}}
      <button
        class="pagination__item{{#if isActive}} pagination__item_active{{/if}}"
        type="button"
        data-page="{{page}}"
        aria-label="{{ariaLabel}}"
        {{#if isActive}}aria-current="page"{{/if}}
        {{#if isDisabled}}disabled{{/if}}
      >{{label}}</button>
    {{/if}}
  {{/each}}
</nav>
