<article class="applicant-card" {{#if board}}draggable="true" data-candidate="{{id}}"{{/if}}>
  <div class="applicant-card__summary">
    <div class="applicant-card__identity">
      <span class="applicant-card__avatar" data-image-url="{{avatarUrl}}" aria-hidden="true">{{initials}}</span>
      <h2 class="applicant-card__name"><a href="/applicants/{{id}}" draggable="false">{{name}}</a></h2>
      <span class="applicant-card__status applicant-card__status_{{status.type}}">{{status.label}}</span>
    </div>
    <div class="applicant-card__details">
      <p class="applicant-card__detail">Вакансия: {{vacancy}}</p>
      <p class="applicant-card__detail">Резюме: {{resume}}</p>
    </div>
  </div>
  {{#if coverLetter}}
    <details class="applicant-card__letter">
      <summary>Сопроводительное письмо</summary>
      <p>{{coverLetter}}</p>
    </details>
  {{/if}}
  <footer class="applicant-card__bottom"><small>{{date}}</small><button type="button" class="icon-button" aria-label="Быстрый просмотр" data-preview="{{id}}">⋮</button></footer>
  {{#if resumeId}}<a class="applicant-card__button" href="/resumes/{{resumeId}}">Смотреть резюме</a>{{/if}}
</article>
