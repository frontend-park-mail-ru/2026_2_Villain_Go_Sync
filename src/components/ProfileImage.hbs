<div class="field profile-image">
  <div class="profile-image__frame{{#if isCompany}} profile-image__frame_company{{/if}}">
    <img {{#if url}}src="{{url}}"{{/if}} alt="{{label}}" {{#unless url}}hidden{{/unless}}>
  </div>
  <div class="profile-image__controls">
    <strong>{{label}}</strong>
    <input id="profile-image" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="profile-image-message">
    <label class="button button_outline" for="profile-image">{{#if isCompany}}Загрузить логотип{{else}}Загрузить фото{{/if}}</label>
    <button class="button button_ghost" type="button" data-image-delete {{#unless url}}hidden{{/unless}}>Удалить изображение</button>
    <p class="field__message" id="profile-image-message" role="status">PNG, JPEG или WebP, до 10 МБ. {{#if deferred}}Изображение сохранится вместе с профилем.{{else}}Изображение сохраняется сразу.{{/if}}</p>
  </div>
</div>
