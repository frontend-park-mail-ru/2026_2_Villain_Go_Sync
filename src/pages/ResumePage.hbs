{{#if isLoading}}
  <section class="detail">
    <div class="detail__heading"></div>
    <div class="detail__card" aria-hidden="true">
      <div class="skeleton detail__skeleton-line detail__skeleton-line_title"></div>
      {{#each skeletonSections}}
        <div class="detail__skeleton-group detail__skeleton-group_section">
          <div class="skeleton detail__skeleton-line detail__skeleton-line_label"></div>
          <div class="detail__skeleton-group">
            <div class="skeleton detail__skeleton-line detail__skeleton-line_wide"></div>
            <div class="skeleton detail__skeleton-line"></div>
            <div class="skeleton detail__skeleton-line"></div>
          </div>
        </div>
      {{/each}}
    </div>
  </section>
{{else if error}}
  <section class="detail">
    <div class="empty-state">
      <h1 class="empty-state__title">{{error.title}}</h1>
      <p class="empty-state__text">{{error.text}}</p>
      {{#if error.canRetry}}
        <button class="button button_secondary empty-state__button" type="button" data-action="retry">
          Повторить
        </button>
      {{else}}
        <a class="button button_secondary empty-state__button" href="/">Вернуться к вакансиям</a>
      {{/if}}
    </div>
  </section>
{{else}}
  <section class="detail{{#if isOwner}} detail_owner{{/if}}">
    {{#if isOwner}}
      <nav class="detail__heading detail__breadcrumbs" aria-label="Навигация">
        <a class="detail__breadcrumb" href="/resumes">Резюме</a>
        <span aria-hidden="true">/</span>
        <span class="detail__breadcrumb-current">{{resume.title}}</span>
      </nav>
    {{else}}
      <div class="detail__heading">
        <h1 class="detail__title">Резюме</h1>
      </div>
    {{/if}}

    <article class="detail__card">
      <div class="detail__header">
        <div class="detail__summary">
          {{#if isOwner}}
            <h1 class="detail__name detail__name_large">{{resume.title}}</h1>
          {{else}}
            <h2 class="detail__name">{{resume.title}}</h2>
          {{/if}}
        </div>
        {{#if isOwner}}
          <div class="detail__actions">
            <a
              class="icon-button icon-button_edit"
              href="/resumes/{{resume.id}}/edit"
              aria-label="Редактировать резюме"
            ></a>
            <button
              class="icon-button icon-button_delete"
              type="button"
              data-action="delete"
              aria-label="Удалить резюме"
            ></button>
          </div>
        {{/if}}
      </div>

      {{#each sections}}
        <section class="detail__section">
          <h2 class="detail__section-title">{{title}}</h2>
          <p class="detail__text">{{text}}</p>
        </section>
      {{/each}}
    </article>
  </section>
{{/if}}
