{{#if isLoading}}
  <section class="detail">
    <div class="detail__heading"></div>
    <div class="detail__layout" aria-hidden="true">
      <div class="detail__column">
        <div class="detail__card">
          <div class="skeleton detail__skeleton-line detail__skeleton-line_title"></div>
        </div>
        {{#each skeletonSections}}
          <div class="detail__card">
            <div class="skeleton detail__skeleton-line detail__skeleton-line_label"></div>
            <div class="skeleton detail__skeleton-line detail__skeleton-line_wide"></div>
            <div class="skeleton detail__skeleton-line"></div>
          </div>
        {{/each}}
      </div>
      <aside class="detail__card">
        <div class="skeleton detail__skeleton-line detail__skeleton-line_label"></div>
        <div class="skeleton edit-form__skeleton-field"></div>
        <div class="skeleton edit-form__skeleton-field"></div>
      </aside>
    </div>
  </section>
{{else if error}}
  <section class="detail">
    <div class="empty-state">
      <h1 class="empty-state__title">{{error.title}}</h1>
      <p class="empty-state__text">{{error.text}}</p>
      {{#if error.canRetry}}
        <button class="button button_secondary empty-state__button" type="button" data-action="retry">
          Повторить
        </button>
      {{else}}
        <a class="button button_secondary empty-state__button" href="/">Вернуться к вакансиям</a>
      {{/if}}
    </div>
  </section>
{{else}}
  <section class="detail detail_resume">
    <nav class="detail__breadcrumbs" aria-label="Навигация">
      {{#if isOwner}}
        <a href="/resumes">Мои резюме</a>{{else}}
        <span>Резюме</span>
      {{/if}}
      <span aria-hidden="true">›</span>
      <span class="detail__breadcrumb-current">{{resume.title}}</span>
    </nav>
    <div class="detail__layout">
      <div class="detail__column">
        <article class="detail__card">
          <h1 class="detail__name detail__name_large">{{resume.title}}</h1>
          <p class="detail__subtitle">Профиль соискателя</p>
        </article>
        {{#each sections}}
          <section class="detail__card">
            <h2 class="detail__section-title">{{title}}</h2>
            <p class="detail__text">{{text}}</p>
          </section>
        {{/each}}
      </div>
      {{#if isOwner}}
        <aside class="detail__card detail__aside">
          <h2 class="detail__section-title">Действия с резюме</h2>
          <a class="button button_secondary" href="/resumes/{{resume.id}}/edit">Редактировать резюме</a>
          <a class="button button_outline" href="/resumes/new?copy={{resume.id}}">Дублировать</a>
          <button class="button button_outline" type="button" data-action="print">Сохранить в PDF</button>
          <button class="button button_ghost" type="button" data-action="delete">Удалить резюме</button>
        </aside>
      {{/if}}
    </div>
  </section>
{{/if}}
