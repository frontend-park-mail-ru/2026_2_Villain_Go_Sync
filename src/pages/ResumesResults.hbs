{{#if isLoading}}
  <div class="card-grid" aria-hidden="true">
    {{#each skeletons}}
      <div class="resume-card resume-card_skeleton">
        <div class="resume-card__summary">
          <div class="skeleton resume-card__skeleton-title"></div>
          <div class="skeleton resume-card__skeleton-text"></div>
        </div>
        <div class="skeleton resume-card__skeleton-button"></div>
      </div>
    {{/each}}
  </div>
{{else if error}}
  <div class="empty-state owner-list__empty">
    <h2 class="empty-state__title">Не удалось загрузить резюме</h2>
    <p class="empty-state__text">{{error}}</p>
    <button class="button button_secondary empty-state__button" type="button" data-action="retry">
      Повторить
    </button>
  </div>
{{else if resumes}}
  <div class="owner-list__list">
    <div class="card-grid">
      {{#if canCreate}}
        <a class="create-card" aria-label="Создать резюме" href="/resumes/new">
          <span class="create-card__plus" aria-hidden="true">+</span>
          <strong>Создать резюме</strong>
          <span>Расскажите о навыках и опыте, чтобы откликаться на вакансии</span>
        </a>
      {{/if}}
      {{#each resumes}}
        <article class="resume-card">
          <div class="resume-card__summary">
            {{#if draftPath}}<p class="owner-list__draft-label">Черновик</p>{{/if}}
            <h2 class="resume-card__title">
              <a class="card-link" href="{{href}}">{{title}}</a>
            </h2>
            {{#if description}}
              <p class="resume-card__description">{{description}}</p>
            {{/if}}
          </div>
          {{#if skills}}<div class="chips">{{#each skills}}<span class="chip">{{name}}</span>{{/each}}</div>{{/if}}
          <div class="resume-card__footer">
            <button
              class="icon-button icon-button_delete"
              type="button"
              data-action="delete"
              {{#if draftPath}}data-draft-path="{{draftPath}}"{{else}}data-id="{{id}}"{{/if}}
              aria-label="Удалить {{#if draftPath}}черновик{{else}}резюме{{/if}} «{{title}}»"
            ></button>
          </div>
        </article>
      {{/each}}
    </div>
    {{! Разметку пагинации собирает компонент из номеров страниц, поэтому вставка без экранирования безопасна. }}
    {{{pagination}}}
  </div>
{{else if hasQuery}}
  <div class="empty-state">
    <h2 class="empty-state__title">По вашему запросу ничего не найдено</h2>
    <p class="empty-state__text">Попробуйте изменить запрос или сбросить фильтры.</p>
    <button class="button button_secondary empty-state__button" type="button" data-action="reset">
      Сбросить поиск и фильтры
    </button>
  </div>
{{else}}
  <div class="card-grid">
    <a class="create-card" aria-label="Создать резюме" href="/resumes/new">
      <span class="create-card__plus" aria-hidden="true">+</span>
      <strong>Создать резюме</strong>
      <span>Расскажите о навыках и опыте, чтобы откликаться на вакансии</span>
    </a>
  </div>
{{/if}}
