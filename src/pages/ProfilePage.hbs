<section class="profile">
  <header>
    <h1 class="profile__title">{{heading}}</h1>
    <p class="profile__subtitle">{{#if isCompany}}Расскажите о компании и помогите кандидатам оценить условия работы{{else}}Данные профиля можно использовать в нескольких резюме{{/if}}</p>
  </header>

  {{#if isLoading}}
    <div class="profile__content" aria-hidden="true">
      <div class="skeleton profile__avatar profile__avatar_skeleton"></div>
      <div class="profile__card">
        <div class="profile__fields">
          {{#each skeletonFields}}
            <div class="detail__skeleton-group">
              <div class="skeleton detail__skeleton-line"></div>
              <div class="skeleton detail__skeleton-line"></div>
              <div class="skeleton detail__skeleton-line"></div>
            </div>
          {{/each}}
        </div>
        <div class="profile__section">
          <div class="detail__skeleton-group">
            <div class="skeleton detail__skeleton-line"></div>
            <div class="skeleton detail__skeleton-line"></div>
            <div class="skeleton detail__skeleton-line"></div>
          </div>
          <div class="detail__skeleton-group">
            <div class="skeleton detail__skeleton-line detail__skeleton-line_wide"></div>
            <div class="skeleton detail__skeleton-line detail__skeleton-line_wide"></div>
            <div class="skeleton detail__skeleton-line"></div>
          </div>
        </div>
      </div>
    </div>
  {{else if error}}
    <div class="empty-state">
      <h2 class="empty-state__title">Не удалось загрузить профиль</h2>
      <p class="empty-state__text">{{error}}</p>
      {{#if canRetry}}
        <button class="button button_secondary empty-state__button" type="button" data-action="retry">
          Повторить
        </button>
      {{/if}}
    </div>
  {{else if isEmpty}}
    <div class="profile__card profile__card_empty">
      <div class="profile__empty-copy">
        <h2 class="profile__empty-title">{{empty.title}}</h2>
        <p class="profile__empty-text">{{empty.text}}</p>
      </div>
      <a class="button button_secondary profile__edit_fill" href="/profile/edit">Заполнить профиль</a>
    </div>
  {{else}}
    <div class="profile__card profile__identity">
      <div class="profile__avatar{{#if isCompany}} profile__avatar_company{{/if}}" aria-hidden="true">{{initials}}</div>
      <h2 class="profile__name">{{name.value}}</h2>
      <a class="button button_secondary" href="/profile/edit">{{#if isCompany}}Редактировать компанию{{else}}Редактировать профиль{{/if}}</a>
    </div>
    <div class="profile__columns">
      <div class="profile__column">
        <section class="profile__card">
          <h2 class="profile__section-title">{{about.title}}</h2>
          <p class="profile__subtitle">{{#if isCompany}}Миссия, деятельность и специализация{{else}}Краткое представление и профессиональные интересы{{/if}}</p>
          <p class="profile__text">{{about.text}}</p>
        </section>
        {{#each sections}}
          <section class="profile__card">
            <h2 class="profile__section-title">{{title}}</h2>
            <p class="profile__subtitle">{{subtitle}}</p>
            <p class="profile__text">Нет данных</p>
          </section>
        {{/each}}
        {{#if isCompany}}
          <section class="profile__card" data-company-jobs hidden></section>
        {{/if}}
      </div>
      <aside class="profile__card">
        <h2 class="profile__section-title">Контакты</h2>
        <p class="profile__subtitle">{{#if isCompany}}Информация для кандидатов{{else}}Управляйте способами связи{{/if}}</p>
        {{#if contact.value}}
          <div>
            <p class="profile__label">{{contact.label}}</p>
            {{#if contact.href}}
              <a class="profile__link" href="{{contact.href}}" target="_blank" rel="noopener noreferrer">{{contact.value}}</a>
            {{else}}
              <p class="profile__value">{{contact.value}}</p>
            {{/if}}
          </div>
        {{/if}}
      </aside>
    </div>
  {{/if}}
</section>
