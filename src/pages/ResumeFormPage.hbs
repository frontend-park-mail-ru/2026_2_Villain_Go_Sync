{{#if profileRequired}}
  <section class="form-page">
    <div class="empty-state">
      <h1 class="empty-state__title">Сначала заполните профиль</h1>
      <p class="empty-state__text">Для создания резюме нужна информация о вас.</p>
      <a class="button button_secondary" href="{{profilePath}}">Заполнить профиль</a>
    </div>
  </section>
{{else if isLoading}}
  <section class="form-page">
    <h1 class="form-page__title">{{heading}}</h1>
    <div class="edit-form" aria-hidden="true">
      {{#each skeletonFields}}
        <div class="detail__skeleton-group">
          <div class="skeleton detail__skeleton-line detail__skeleton-line_label"></div>
          <div class="skeleton edit-form__skeleton-field"></div>
        </div>
      {{/each}}
    </div>
  </section>
{{else if error}}
  <section class="form-page">
    <div class="empty-state">
      <h1 class="empty-state__title">{{error.title}}</h1>
      <p class="empty-state__text">{{error.text}}</p>
      {{#if error.canRetry}}
        <button class="button button_secondary empty-state__button" type="button" data-action="retry">
          Повторить
        </button>
      {{else}}
        <a class="button button_secondary empty-state__button" href="/resumes">К моим резюме</a>
      {{/if}}
    </div>
  </section>
{{else}}
  <section class="form-page">
    <h1 class="form-page__title">{{heading}}</h1>

    <form class="edit-form" novalidate>
      <div class="field">
        <label class="field__label" for="resume-title">Название</label>
        <input
          class="field__input"
          id="resume-title"
          name="title"
          type="text"
          placeholder="Введите название резюме"
          value="{{resume.title}}"
          aria-describedby="resume-title-counter resume-title-message"
        />
        <p class="field__counter" id="resume-title-counter"></p>
        <p class="field__message" id="resume-title-message"></p>
      </div>

      <div class="field">
        <label class="field__label" for="resume-description">Описание</label>
        <textarea
          class="field__input field__textarea"
          id="resume-description"
          name="description"
          placeholder="Опишите ваши навыки и интересы"
          aria-describedby="resume-description-counter resume-description-message"
        >{{resume.description}}</textarea>
        <p class="field__counter" id="resume-description-counter"></p>
        <p class="field__message" id="resume-description-message"></p>
      </div>

      <div class="edit-form__row">
        <div class="field">
          <label class="field__label" for="resume-experience">Опыт</label>
          <textarea
            class="field__input field__textarea"
            id="resume-experience"
            name="experience"
            placeholder="Опишите ваш опыт"
            aria-describedby="resume-experience-counter resume-experience-message"
          >{{resume.experience}}</textarea>
          <p class="field__counter" id="resume-experience-counter"></p>
          <p class="field__message" id="resume-experience-message"></p>
        </div>

        <div class="field">
          <label class="field__label" for="resume-education">Образование</label>
          <textarea
            class="field__input field__textarea"
            id="resume-education"
            name="education"
            placeholder="Расскажите об образовании"
            aria-describedby="resume-education-counter resume-education-message"
          >{{resume.education}}</textarea>
          <p class="field__counter" id="resume-education-counter"></p>
          <p class="field__message" id="resume-education-message"></p>
        </div>
      </div>

      <div class="edit-form__actions">
        <button class="button button_secondary edit-form__submit" type="submit">{{submitLabel}}</button>
        <button class="button button_ghost edit-form__cancel" type="button" data-action="cancel">Отмена</button>
      </div>
    </form>
  </section>
{{/if}}
