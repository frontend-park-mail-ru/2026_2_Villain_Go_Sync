<section class="resumes">
  <div class="resumes__heading">
    <h1 class="resumes__title">Мои резюме</h1>
    <a
      class="button button_secondary button_icon resumes__create"
      href="/resumes/new"
      aria-label="Создать резюме"
      title="Создать резюме"
    ></a>
  </div>

  <form class="resumes__search" role="search" novalidate hidden>
    <input
      class="field__input resumes__search-input"
      name="query"
      type="search"
      placeholder="Название резюме"
      aria-label="Поиск по названию резюме"
    />
    <button
      class="button button_secondary button_icon resumes__search-button"
      type="submit"
      aria-label="Найти"
    ></button>
  </form>

  <div class="resumes__content" aria-live="polite"></div>
</section>
