{{#if isLoading}}
  <div class="card-grid">
    {{#each skeletons}}
      <img class="catalog-loading skeleton" src="/images/vacancy-loading.svg" width="432" height="318" alt="">
    {{/each}}
  </div>
{{else if error}}
  <div class="empty-state">
    <h2 class="empty-state__title">Не удалось загрузить вакансии</h2>
    <p class="empty-state__text">{{error}}</p>
    <button class="button button_secondary empty-state__button" type="button" data-action="retry">
      Повторить
    </button>
  </div>
{{else if vacancies}}
  <div class="card-grid">
    {{#each vacancies}}
      <article class="vacancy-card">
        {{#if ../showFavorites}}<button type="button" class="favorite-toggle" data-favorite="{{id}}" aria-label="Сохранить в избранное" aria-pressed="{{favorite}}">{{#if favorite}}♥{{else}}♡{{/if}}</button>{{/if}}
        {{#if company}}
          <div class="vacancy-card__company">
            <span class="vacancy-card__logo" data-image-url="{{logoUrl}}" aria-hidden="true">{{company}}</span>
            <span class="vacancy-card__company-name">{{company}}</span>
          </div>
        {{/if}}
        <h2 class="vacancy-card__title"><a class="card-link" href="/vacancies/{{id}}">{{title}}</a></h2>
        <p class="vacancy-card__salary">{{salary}}</p>
        {{#if tags.length}}
          <div class="vacancy-card__tags">
            {{#each tags}}
              <span class="chip">{{this}}</span>
            {{/each}}
          </div>
        {{/if}}
        <div class="vacancy-card__footer">
          <p class="vacancy-card__date">{{published}}</p>
        </div>
      </article>
    {{/each}}
  </div>
  {{! Разметку пагинации собирает компонент из номеров страниц, поэтому вставка без экранирования безопасна. }}
  {{{pagination}}}
{{else if hasQuery}}
  <div class="empty-state">
    <h2 class="empty-state__title">По вашему запросу ничего не найдено</h2>
    <p class="empty-state__text">Попробуйте изменить запрос или сбросить выбранные фильтры.</p>
    <button class="button button_secondary empty-state__button" type="button" data-action="reset">
      Сбросить поиск и фильтры
    </button>
  </div>
{{else}}
  <div class="empty-state">
    <h2 class="empty-state__title">Вакансий пока нет</h2>
    <p class="empty-state__text">Загляните позже — здесь появятся новые предложения.</p>
  </div>
{{/if}}
