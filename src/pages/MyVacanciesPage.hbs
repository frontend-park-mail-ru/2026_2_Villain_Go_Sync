<section class="owner-list owner-list_vacancies">
  <div class="owner-list__heading">
    <h1 class="owner-list__title">Мои вакансии</h1>
  </div>

  <form class="owner-list__search" role="search" novalidate>
    <input
      class="field__input owner-list__search-input"
      name="query"
      type="search"
      placeholder="Название вакансии"
      aria-label="Поиск по названию вакансии"
    />
    <button
      class="button button_secondary button_icon owner-list__search-button"
      type="submit"
      aria-label="Найти"
    ></button>
    <button class="button button_outline list-filter-trigger" type="button" data-filters>Фильтры</button>
  </form>

  <p class="empty-state__text" data-vacancy-creation-notice role="status" hidden></p>
  <div class="owner-list__content" aria-live="polite"></div>
</section>
