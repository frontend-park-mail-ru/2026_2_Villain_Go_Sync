<section class="vacancies">
  <div>
    {{#if employerId}}
      <h1 class="vacancies__title">Вакансии компании</h1>
      <a href="/employers/{{employerId}}">К профилю компании</a>
    {{else}}
      <h1 class="vacancies__title">Вакансии</h1>
      <p class="vacancies__subtitle">Найдите работу, которая подходит именно вам.</p>
    {{/if}}
  </div>

  <form class="vacancies__search" novalidate>
    <div class="field vacancies__search-field">
      <input
        class="field__input"
        id="vacancies-query"
        name="query"
        type="search" aria-label="Поиск вакансий"
        placeholder="Должность, профессия или компания"
      />
    </div>
    <button
      class="button button_secondary button_icon vacancies__search-button"
      type="submit"
      aria-label="Найти"
    ></button>
    <button class="button button_outline list-filter-trigger" type="button" data-filters>Фильтры</button>
  </form>

  <div class="chips vacancies__filters" role="group" aria-label="Категории вакансий"></div>

  <div class="vacancies__results" aria-live="polite"></div>
</section>
