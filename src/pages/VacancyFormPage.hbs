{{#if profileRequired}}
  <section class="form-page">
    <div class="empty-state">
      <h1 class="empty-state__title">Сначала заполните профиль</h1>
      <p class="empty-state__text">Для создания вакансии нужна информация о компании.</p>
      <a class="button button_secondary" href="{{profilePath}}">Заполнить профиль</a>
    </div>
  </section>
{{else if isLoading}}
  <section class="form-page">
    <h1 class="form-page__title">{{heading}}</h1>
    <div class="edit-form" aria-hidden="true">
      {{#each skeletonFields}}
        <div class="detail__skeleton-group">
          <div class="skeleton detail__skeleton-line detail__skeleton-line_label"></div>
          <div class="skeleton edit-form__skeleton-field"></div>
        </div>
      {{/each}}
    </div>
  </section>
{{else if error}}
  <section class="form-page">
    <div class="empty-state">
      <h1 class="empty-state__title">{{error.title}}</h1>
      <p class="empty-state__text">{{error.text}}</p>
      {{#if error.canRetry}}
        <button class="button button_secondary empty-state__button" type="button" data-action="retry">
          Повторить
        </button>
      {{else}}
        <a class="button button_secondary empty-state__button" href="/my/vacancies">К моим вакансиям</a>
      {{/if}}
    </div>
  </section>
{{else}}
  <section class="form-page">
    <h1 class="form-page__title">{{heading}}</h1>

    <form class="edit-form editor" novalidate>
      <p class="editor__instructions" data-instructions></p>
      <nav class="editor__steps" aria-label="Этапы заполнения">
        <button type="button" data-step>
          <b>1</b>
          <span>Основное<small>Предстоит</small></span>
        </button>
        <button type="button" data-step>
          <b>2</b>
          <span>Условия<small>Предстоит</small></span>
        </button>
        <button type="button" data-step>
          <b>3</b>
          <span>Описание и навыки<small>Предстоит</small></span>
        </button>
        <button type="button" data-step>
          <b>4</b>
          <span>Проверка<small>Предстоит</small></span>
        </button>
      </nav>
      <div class="editor__body">
        <div class="editor__panels">
          <section class="editor__panel" tabindex="-1" data-panel data-instructions="Укажите название и специализацию. Логотип относится к профилю компании." hidden>
            <h2>Основная информация</h2>
            <div class="field">
              <label class="field__label" for="vacancy-title">Название вакансии *</label>
              <input
                class="field__input"
                id="vacancy-title"
                name="title"
                type="text"
                placeholder="Введите название вакансии"
                value="{{vacancy.title}}"
                aria-describedby="vacancy-title-counter vacancy-title-message"
              />
              <p class="field__counter" id="vacancy-title-counter"></p>
              <p class="field__message" id="vacancy-title-message"></p>
            </div>

            <label class="field">Направление вакансии<input class="field__input" disabled placeholder="Пока недоступно"></label>
            <p class="editor__hint">Компания и логотип подставляются из профиля работодателя.</p>
          </section>
          <section class="editor__panel" tabindex="-1" data-panel data-instructions="Настройте зарплату, опыт, занятость, место и график работы." hidden>
            <h2>Зарплата и опыт</h2>
            <div class="vacancy-form__salary">
              <div class="field">
                <label class="field__label" for="vacancy-salary-from">Зарплата от</label>
                <input
                  class="field__input"
                  id="vacancy-salary-from"
                  name="salaryFrom"
                  type="text"
                  inputmode="numeric"
                  placeholder="Введите сумму"
                  value="{{salaryFrom}}"
                  aria-describedby="vacancy-salary-from-message"
                />
                <p class="field__message" id="vacancy-salary-from-message"></p>
              </div>

              <div class="field">
                <label class="field__label" for="vacancy-salary-to">Зарплата до</label>
                <input
                  class="field__input"
                  id="vacancy-salary-to"
                  name="salaryTo"
                  type="text"
                  inputmode="numeric"
                  placeholder="Введите сумму"
                  value="{{salaryTo}}"
                  aria-describedby="vacancy-salary-to-message"
                />
                <p class="field__message" id="vacancy-salary-to-message"></p>
              </div>

              <div class="field">
                <label class="field__label" for="vacancy-currency">Валюта</label>
                <select class="field__input field__select" id="vacancy-currency" name="currency">
                  {{#each currencies}}
                    <option value="{{code}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
            </div>

            <fieldset class="unavailable-options" disabled>
              <legend>Опыт работы</legend>
              <span class="chip">Без опыта</span>
              <span class="chip">1–3 года</span>
              <span class="chip">3–6 лет</span>
              <span class="chip">Более 6 лет</span>
            </fieldset>
            <fieldset class="unavailable-options" disabled>
              <legend>Тип занятости</legend>
              <span class="chip">Полная</span>
              <span class="chip">Частичная</span>
            </fieldset>
            <fieldset class="unavailable-options" disabled>
              <legend>Формат работы</legend>
              <span class="chip">Офис</span>
              <span class="chip">Гибрид</span>
              <span class="chip">Удалённо</span>
            </fieldset>
            <fieldset class="unavailable-options" disabled>
              <legend>График</legend>
              <span class="chip">5/2</span>
              <span class="chip">Гибкий</span>
              <span class="chip">Сменный</span>
            </fieldset>
            <label class="field">Город<input class="field__input" disabled placeholder="Пока недоступно"></label>
          </section>
          <section class="editor__panel" tabindex="-1" data-panel data-instructions="Расскажите о вакансии, обязанностях, требованиях, преимуществах и навыках." hidden>
            <h2>Описание и требования</h2>
            <div class="field">
              <label class="field__label" for="vacancy-description">О вакансии *</label>
              <textarea
                class="field__input field__textarea"
                id="vacancy-description"
                name="description"
                placeholder="Опишите задачи и требования"
                aria-describedby="vacancy-description-counter vacancy-description-message"
              >{{vacancy.description}}</textarea>
              <p class="field__counter" id="vacancy-description-counter"></p>
              <p class="field__message" id="vacancy-description-message"></p>
            </div>

            <label class="field">Обязанности<textarea class="field__input" disabled placeholder="Пока недоступно"></textarea></label>
            <label class="field">Требования<textarea class="field__input" disabled placeholder="Пока недоступно"></textarea></label>
            <label class="field">Навыки<input class="field__input" disabled placeholder="Пока недоступно"></label>
          </section>
          <section class="editor__panel" tabindex="-1" data-panel data-instructions="Проверьте данные перед публикацией." hidden>
            <h2>Проверка вакансии</h2>
            <dl class="editor__review">
              <div>
                <dt>Название</dt>
                <dd data-value="title"></dd>
              </div>
              <div>
                <dt>Зарплата от</dt>
                <dd data-value="salaryFrom"></dd>
              </div>
              <div>
                <dt>Зарплата до</dt>
                <dd data-value="salaryTo"></dd>
              </div>
              <div>
                <dt>Валюта</dt>
                <dd data-value="currency"></dd>
              </div>
              <div>
                <dt>О вакансии</dt>
                <dd data-value="description"></dd>
              </div>
            </dl>
          </section>
        </div>
        <aside class="editor__preview">
          <small>ПРЕДПРОСМОТР</small>
          {{#if company}}
            <div class="vacancy-card__company">
              <span class="vacancy-card__logo" data-image-url="{{logo}}" aria-hidden="true">{{company}}</span>
              <span>{{company}}</span>
            </div>
          {{/if}}
          <h2 data-value="title" data-empty="Название вакансии"></h2>
          <p data-value="description" data-empty=""></p>
        </aside>
      </div>
      <div class="edit-form__actions editor__actions">
        <button type="button" class="button button_outline" data-back>← Назад</button>
        <button type="submit" class="button button_secondary edit-form__submit">{{submitLabel}}</button>
        {{#unless isEdit}}
          <button type="button" class="button button_outline" data-draft>Сохранить черновик</button>
        {{/unless}}
        <button type="button" class="button button_ghost" data-action="cancel">Отмена</button>
      </div>
    </form>
  </section>
{{/if}}
