{{#if isLoading}}
  <div class="card-grid" aria-hidden="true">
    {{#each skeletons}}
      <div class="vacancy-card vacancy-card_skeleton">
        <div class="vacancy-card__skeleton-title">
          <div class="skeleton"></div>
          <div class="skeleton"></div>
        </div>
        <div class="vacancy-card__skeleton-description">
          <div class="skeleton"></div>
          <div class="skeleton"></div>
        </div>
        <div class="vacancy-card__tags">
          <div class="skeleton vacancy-card__skeleton-tag"></div>
          <div class="skeleton vacancy-card__skeleton-tag"></div>
          <div class="skeleton vacancy-card__skeleton-tag"></div>
        </div>
        <div class="skeleton vacancy-card__skeleton-salary"></div>
        <div class="skeleton vacancy-card__skeleton-delete"></div>
      </div>
    {{/each}}
  </div>
{{else if error}}
  <div class="empty-state owner-list__empty">
    <h2 class="empty-state__title">Не удалось загрузить вакансии</h2>
    <p class="empty-state__text">{{error}}</p>
    <button class="button button_secondary empty-state__button" type="button" data-action="retry">
      Повторить
    </button>
  </div>
{{else if vacancies}}
  <div class="owner-list__list">
    <div class="card-grid">
      {{#if canCreate}}
        <a class="create-card" aria-label="Создать вакансию" href="/vacancies/new">
          <span class="create-card__plus" aria-hidden="true">+</span>
          <strong>Создать вакансию</strong>
          <span>Добавьте новую вакансию, чтобы начать поиск кандидатов</span>
        </a>
      {{/if}}
      {{#each vacancies}}
        <article class="vacancy-card vacancy-card_owner">
          <div class="vacancy-card__identity">
            {{#if draftPath}}<p class="owner-list__draft-label">Черновик</p>{{/if}}
            <h2 class="vacancy-card__title">
              <a class="card-link" href="{{href}}">{{title}}</a>
            </h2>
            {{#if description}}
              <p class="vacancy-card__description">{{description}}</p>
            {{/if}}
          </div>
          {{#if categories}}
            <div class="chips">
              {{#each categories}}<span class="chip">{{this}}</span>{{/each}}
              {{#if hiddenCategoryCount}}<span class="chip" aria-label="Другие категории: {{hiddenCategoryCount}}">+{{hiddenCategoryCount}}</span>{{/if}}
            </div>
          {{/if}}
          <div class="vacancy-card__footer">
            {{#unless draftPath}}<p class="vacancy-card__salary{{#unless hasSalary}} vacancy-card__salary_empty{{/unless}}">{{salary}}</p>{{/unless}}
            <div class="vacancy-card__actions">
              <button
                class="icon-button icon-button_delete"
                type="button"
                data-action="delete"
                {{#if draftPath}}data-draft-path="{{draftPath}}"{{else}}data-id="{{id}}"{{/if}}
                aria-label="Удалить {{#if draftPath}}черновик{{else}}вакансию{{/if}} «{{title}}»"
              ></button>
            </div>
          </div>
        </article>
      {{/each}}
    </div>
    {{! Разметку пагинации собирает компонент из номеров страниц, поэтому вставка без экранирования безопасна. }}
    {{{pagination}}}
  </div>
{{else if hasQuery}}
  <div class="empty-state">
    <h2 class="empty-state__title">По вашему запросу ничего не найдено</h2>
    <p class="empty-state__text">Попробуйте изменить запрос или сбросить фильтры.</p>
    <button class="button button_secondary empty-state__button" type="button" data-action="reset">
      Сбросить поиск и фильтры
    </button>
  </div>
{{else}}
  <div class="card-grid">
    <a class="create-card" aria-label="Создать вакансию" href="/vacancies/new">
      <span class="create-card__plus" aria-hidden="true">+</span>
      <strong>Создать вакансию</strong>
      <span>Добавьте новую вакансию, чтобы начать поиск кандидатов</span>
    </a>
  </div>
{{/if}}
