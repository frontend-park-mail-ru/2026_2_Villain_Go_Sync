{{#if isLoading}}
  <section class="detail">
    <div class="detail__heading"></div>
    <div class="detail__card detail__card_loading" aria-hidden="true">
      <div class="detail__skeleton-group">
        <div class="skeleton detail__skeleton-line"></div>
        <div class="skeleton detail__skeleton-line"></div>
        <div class="skeleton detail__skeleton-line"></div>
      </div>
      <div class="detail__skeleton-group">
        <div class="skeleton detail__skeleton-line"></div>
        <div class="skeleton detail__skeleton-line"></div>
        <div class="skeleton detail__skeleton-line"></div>
      </div>
      <div class="detail__skeleton-group">
        <div class="skeleton detail__skeleton-line"></div>
        <div class="skeleton detail__skeleton-line"></div>
        <div class="skeleton detail__skeleton-line"></div>
      </div>
    </div>
  </section>
{{else if error}}
  <section class="detail">
    <div class="empty-state">
      <h1 class="empty-state__title">{{error.title}}</h1>
      <p class="empty-state__text">{{error.text}}</p>
      {{#if error.canRetry}}
        <button class="button button_secondary empty-state__button" type="button" data-action="retry">
          Повторить
        </button>
      {{else}}
        <a class="button button_secondary empty-state__button" href="/">Вернуться к вакансиям</a>
      {{/if}}
    </div>
  </section>
{{else}}
  <section class="detail">
    <nav class="detail__breadcrumbs" aria-label="Навигация">
      {{#if isOwner}}
        <a href="/my/vacancies">Мои вакансии</a>{{else}}
        <a href="/">Вакансии</a>
      {{/if}}
      <span aria-hidden="true">›</span>
      <span class="detail__breadcrumb-current">{{vacancy.title}}</span>
    </nav>
    <div class="detail__layout">
      <div class="detail__column">
        <article class="detail__card">
          <h1 class="detail__name detail__name_large">{{vacancy.title}}</h1>
          {{#if company}}
            <p class="detail__subtitle">{{#if companyPath}}<a href="{{companyPath}}">{{company}}</a>{{else}}{{company}}{{/if}}</p>
          {{/if}}
          <p class="detail__salary">{{salary}}</p>
          {{#if conditions}}<p class="detail__subtitle">{{conditions}}</p>{{/if}}
          {{#if level}}<p class="detail__subtitle">Опыт: {{level}}</p>{{/if}}
          {{#if vacancy.categories}}<div class="chips">{{#each vacancy.categories}}<span class="chip">{{this}}</span>{{/each}}</div>{{/if}}
        </article>
        <section class="detail__card">
          <h2 class="detail__section-title">О вакансии</h2>
          <p class="detail__text">{{vacancy.description}}</p>
        </section>
        {{#if vacancy.responsibilities}}<section class="detail__card"><h2>Обязанности</h2><p class="detail__text">{{vacancy.responsibilities}}</p></section>{{/if}}
        {{#if vacancy.requirements}}<section class="detail__card"><h2>Требования</h2><p class="detail__text">{{vacancy.requirements}}</p></section>{{/if}}
        {{#if vacancy.offer}}<section class="detail__card"><h2>Условия</h2><p class="detail__text">{{vacancy.offer}}</p></section>{{/if}}
        {{#if vacancy.work_hours}}<p>Рабочие часы · {{vacancy.work_hours}}</p>{{/if}}
        {{#if vacancy.office_address}}<p>Адрес офиса · {{vacancy.office_address}}</p>{{/if}}
        {{#if vacancy.apply_until}}<p>Приём откликов до {{vacancy.apply_until}}</p>{{/if}}
      </div>
      {{#if showActions}}
        <aside class="detail__card detail__aside">
          <h2 class="detail__section-title">{{#if isOwner}}Отклики и кандидаты{{else}}Отклик на вакансию{{/if}}</h2>
          {{#if published}}
            <p class="detail__subtitle">Опубликована · {{published}}</p>
          {{/if}}
          {{#if isOwner}}
            <a class="button button_secondary" href="/vacancies/{{vacancy.id}}/edit">Редактировать вакансию</a>
            <a class="button button_outline" href="/applicants?vacancy={{vacancy.id}}">Посмотреть отклики</a>
            <button class="button button_ghost" type="button" data-action="delete">Удалить вакансию</button>
          {{else}}
            {{#if isGuest}}
              <a class="button button_secondary" href="/login">Откликнуться</a>
            {{else}}
              <button class="button button_secondary" type="button" data-action="apply">Откликнуться</button>
            {{/if}}
            <button class="button button_outline" type="button" data-favorite aria-pressed="{{favorite}}">{{#if favorite}}♥ В избранном{{else}}♡ Сохранить в избранное{{/if}}</button>
            <p class="detail__subtitle">Выберите своё резюме и при желании добавьте сопроводительное письмо.</p>
          {{/if}}
        </aside>
      {{/if}}
    </div>
  </section>
{{/if}}
