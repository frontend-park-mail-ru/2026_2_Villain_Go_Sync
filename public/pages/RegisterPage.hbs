<section class="auth">
  <div class="auth__hero">
    <div class="auth__hero-accent">
      <img class="auth__hero-image" src="/images/hero-arc.svg" alt="" width="64" height="32" />
    </div>
    <p class="auth__hero-title">It's HireNoon.</p>
    <p class="auth__hero-slogan">Time to get hired.</p>
    <p class="auth__hero-text">Самое время найти работу.</p>
  </div>

  <div class="auth__card auth__card_compact">
    <h1 class="auth__title">Создать аккаунт</h1>
    <p class="auth__subtitle">Зарегистрируйтесь, чтобы начать.</p>

    <form class="auth__form" novalidate>
      <div class="field">
        <span class="field__label">Кто вы?</span>
        <div class="chips">
          <input class="chip__control" id="register-role-seeker" name="role" type="radio" value="seeker" />
          <label class="chip" for="register-role-seeker">Ищу работу</label>
          <input class="chip__control" id="register-role-employer" name="role" type="radio" value="employer" />
          <label class="chip" for="register-role-employer">Ищу сотрудников</label>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="register-email">Email</label>
        <input
          class="field__input"
          id="register-email"
          name="email"
          type="email"
          placeholder="name@example.com"
          autocomplete="email"
        />
        <p class="field__message"></p>
      </div>

      <div class="field">
        <label class="field__label" for="register-password">Пароль</label>
        <input
          class="field__input"
          id="register-password"
          name="password"
          type="password"
          placeholder="Введите пароль"
          autocomplete="new-password"
        />
        <p class="field__message">Минимум 8 символов, заглавная и строчная буква и цифра.</p>
      </div>

      <button class="button" type="submit">Создать аккаунт</button>
    </form>

    <p class="auth__footer">Уже есть аккаунт? <a href="/login">Войти</a></p>
  </div>
</section>
