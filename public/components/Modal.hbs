<dialog class="modal">
  <div class="modal__content">
    <div class="modal__header">
      <h2 class="modal__title">{{title}}</h2>
      <button class="modal__close" type="button" data-result="cancel" aria-label="Закрыть">×</button>
    </div>
    <p class="modal__text">{{text}}</p>
    <div class="modal__actions">
      <button class="button button_ghost modal__button" type="button" data-result="cancel">{{cancelLabel}}</button>
      <button class="button modal__button" type="button" data-result="confirm">{{confirmLabel}}</button>
    </div>
  </div>
</dialog>
